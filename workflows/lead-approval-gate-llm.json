        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Deterministic rule-based fit score (0-100). Pure function, no I/O.\nfunction scoreLeadRules(lead) {\n  let score = 0;\n  const reasons = [];\n  const add = (points, why) => {\n    score += points;\n    reasons.push(`${why} (${points >= 0 ? '+' : ''}${points})`);\n  };\n\n  const e = lead.employees;\n  if (e !== null && e !== undefined) {\n    if (e >= 11 && e <= 200) add(25, 'company size 11-200');\n    else if (e >= 201 && e <= 1000) add(20, 'company size 201-1000');\n    else if (e > 1000) add(15, 'company size over 1000');\n    else add(10, 'company size 1-10');\n  }\n\n  const title = String(lead.title || '');\n  if (/\\b(founder|owner|ceo|cto|coo|chief|head|vp|vice president|director)\\b/i.test(title)) {\n    add(25, 'senior title');\n  } else if (/\\b(manager|lead|principal)\\b/i.test(title)) {\n    add(10, 'manager-level title');\n  }\n\n  const budget = Number(lead.budget_usd || 0);\n  if (budget >= 5000) add(30, 'budget at least 5000 USD');\n  else if (budget >= 1000) add(15, 'budget at least 1000 USD');\n\n  const message = String(lead.message || '').toLowerCase();\n  const keywords = ['automation', 'n8n', 'workflow', 'integration', 'crm', 'api', 'webhook'];\n  const found = keywords.filter((k) => message.includes(k));\n  if (found.length) add(Math.min(found.length, 3) * 5, `mentions ${found.slice(0, 3).join(', ')}`);\n\n  if (/@(gmail|yahoo|outlook|hotmail|proton|protonmail)\\./i.test(String(lead.email || ''))) {\n    add(-10, 'free-mail address');\n  }\n\n  score = Math.max(0, Math.min(100, score));\n  const tier = score >= 70 ? 'high' : score >= 40 ? 'medium' : 'low';\n  return { fit_score: score, tier, reasons };\n}\n// Take the LLM answer if it is well-formed; otherwise fall back to the rules.\nconst { lead } = $('Validate lead').first().json;\nconst clean = (s) => String(s).replace(/[\\r\\n\\t]+/g, ' ').trim();\nconst response = $input.first().json;\n\nlet parsed = null;\nlet failure = null;\nif (response.error) {\n  failure = `llm_request_failed: ${clean(response.error.message || response.error).slice(0, 120)}`;\n} else {\n  try {\n    const content = response.choices[0].message.content;\n    parsed = JSON.parse(content);\n  } catch (e) {\n    failure = 'llm_answer_not_json';\n  }\n}\nif (parsed) {\n  const okScore = typeof parsed.fit_score === 'number' && parsed.fit_score >= 0 && parsed.fit_score <= 100;\n  const okDraft =\n    typeof parsed.draft_subject === 'string' && parsed.draft_subject.trim().length > 0 &&\n    typeof parsed.draft_body === 'string' && parsed.draft_body.trim().length > 0;\n  if (!okScore) failure = 'llm_score_out_of_range';\n  else if (!okDraft) failure = 'llm_draft_missing';\n}\n\nif (failure) {\n  const rules = scoreLeadRules(lead);\n  const first = clean(lead.name).split(/\\s+/)[0];\n  return [{\n    json: {\n      lead, ...rules, scored_by: 'rules-fallback', fallback_reason: failure,\n      draft_subject: clean(`Re: your enquiry from ${lead.company}`).slice(0, 150),\n      draft_body: `Hi ${first},\\n\\nThanks for getting in touch. Would a 20 minute call this week suit you?\\n\\nBest regards`,\n    },\n  }];\n}\n\nconst score = Math.round(parsed.fit_score);\nconst tier = score >= 70 ? 'high' : score >= 40 ? 'medium' : 'low';\nreturn [{\n  json: {\n    lead, fit_score: score, tier,\n    reasons: [clean(parsed.rationale || 'no rationale').slice(0, 300)],\n    scored_by: 'llm',\n    draft_subject: clean(parsed.draft_subject).slice(0, 150),\n    draft_body: String(parsed.draft_body).slice(0, 4000),\n  },\n}];"
      },
      "id": "5340ffd3-fd3b-4763-a09c-c0e88b55506f",
      "name": "Parse LLM answer",
