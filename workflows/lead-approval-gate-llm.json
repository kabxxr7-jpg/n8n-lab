        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'mock-fit-1', response_format: { type: 'json_object' }, messages: [ { role: 'system', content: 'You qualify inbound B2B leads for a workflow automation consultancy. Reply with one JSON object with the keys fit_score (integer 0-100), rationale (string), draft_subject (string) and draft_body (string). Reply with nothing else.' }, { role: 'user', content: JSON.stringify($json.lead) } ] } }}",
